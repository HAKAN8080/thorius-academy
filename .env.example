# Conversion tracking — place real IDs in Vercel/env (do not commit secrets)
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID — digits only, e.g. 1577275556908441
# Must Redeploy after setting (inlined at build time)
NEXT_PUBLIC_META_PIXEL_ID=
